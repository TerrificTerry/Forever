# App
APP_NAME="Spirit Archive"
APP_URL="http://localhost:3000"
NODE_ENV="development"

# Database
DATABASE_URL="postgresql://spirit_user:change_this@postgres:5432/spirit_archive"

# Auth (generate a long random value for production)
AUTH_SECRET="replace-with-random-long-secret"
SETUP_TOKEN="replace-with-temporary-first-setup-token"
SESSION_DAYS="30"
SECONDARY_UNLOCK_MINUTES="30"

# Optional setup defaults
ADMIN_EMAIL=""
ADMIN_INITIAL_PASSWORD=""
DIARY_SECONDARY_PASSWORD=""
PRIVATE_DATA_SECONDARY_PASSWORD=""

# AI — read on the server only
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4.1-mini"

# Stock provider
STOCK_API_PROVIDER="manual"
ALPHA_VANTAGE_API_KEY=""
FINNHUB_API_KEY=""
TWELVE_DATA_API_KEY=""

# File storage
UPLOAD_STORAGE_PROVIDER="local"
LOCAL_UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB="25"
